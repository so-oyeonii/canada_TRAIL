# TRAIL 로컬 개발용 환경변수 — 이 파일은 git에 올라가지 않는다(.gitignore).
# 값이 비어 있는 줄만 채우면 된다. 채운 뒤 dev 서버를 재시작해야 반영된다.
#
# 같은 이름을 Vercel 대시보드(Project → Settings → Environment Variables)에도 넣어야
# 배포본에서 동작한다. NEXT_PUBLIC_ 으로 시작하지 않는 값은 Production/Preview 모두
# "Sensitive"로 표시할 것.

# ─────────────────────────────────────────────────────────────
# 1. OpenAI — Trail AI 대화
# ─────────────────────────────────────────────────────────────
# platform.openai.com → API keys → Create new secret key
# 프로젝트 단위 키(sk-proj-...)를 만들고, 그 프로젝트에 월 예산 상한을 걸어둘 것.
OPENAI_API_KEY=

# 비워두면 gpt-5.6-luna 를 쓴다. 품질을 올리려면 gpt-5.6-terra.
OPENAI_MODEL=gpt-5.6-luna

# ─────────────────────────────────────────────────────────────
# 2. Supabase — 계정 · 여행 · 구매 · 이송 데이터
# ─────────────────────────────────────────────────────────────
# 아래 두 개는 Supabase 대시보드 → Project Settings → API 에 있다.
# 이 둘은 브라우저에 노출되는 것이 정상이다. 데이터 보호는 키가 아니라
# RLS(Row Level Security) 정책이 한다.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co

# Project Settings → API → Publishable key (구 anon public key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# 3. Supabase 관리 키 (필수)
# ─────────────────────────────────────────────────────────────
# Project Settings → API → Secret key (구 service_role key)
# 이 키는 RLS를 통째로 무시한다(BYPASSRLS). 브라우저 코드에서 절대 import 금지.
#
# 마이그레이션 0013부터 예산 변경 승인·거절이 이 키를 요구한다. plans 와
# budget_changes 의 UPDATE 권한을 authenticated 에서 회수했고, 승인 3쓰기는
# service_role 만 실행할 수 있는 함수 안에서 한 트랜잭션으로 일어난다.
# 비어 있으면 승인/거절 라우트가 503을 답한다(절반만 승인되는 일은 없다).
# 이송 확정·결제 기록·파트너 커스터디도 같은 키를 쓴다.
# 첫 여행 등록(POST /api/trips)은 이 키 없이도 동작한다.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# 4. 이송 커스터디 — 드롭오프 패스 · 파트너 단말 · 시뮬레이터
# ─────────────────────────────────────────────────────────────
# QR 드롭오프 패스의 HMAC 서명 키. 32바이트 랜덤이면 된다:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# DB에는 토큰의 sha256 해시만 들어간다. 키를 교체하면 발급된 패스는 전부 무효.
# 비어 있으면 패스 발급 라우트가 503, 파트너 스캔 라우트가 404를 답한다.
TRAIL_PASS_SIGNING_KEY=

# 파트너 단말이 /api/partner/* 를 부를 때 보내는 공유 키(x-trail-partner-key).
# 비워두면 그 라우트들은 존재를 알리지 않고 404다.
TRAIL_PARTNER_KEY=

# 파트너 단말과 기사 앱 대역. `on` 일 때만, 그리고 source='simulated' 행에만
# /api/transfers/{id}/simulate 가 동작한다. 그 외에는 404.
TRAIL_SIMULATOR=

# ─────────────────────────────────────────────────────────────
# 5. 로컬 개발용 로그인 우회 — 이메일 없이 바로 앱 화면 보기
# ─────────────────────────────────────────────────────────────
# /auth/dev-signin 은 자물쇠 셋이 동시에 열려야 열린다:
#   1. 로컬 개발 빌드일 것 (NODE_ENV=production 이거나 VERCEL_ENV 가 있으면 무조건 404)
#   2. TRAIL_DEV_LOGIN=on 일 것
#   3. 요청 이메일이 TRAIL_DEV_LOGIN_EMAIL 과 정확히 같을 것 (?email= 로 다른 주소를 넣으면 404)
# 여는 순간 서비스키로 일회용 코드를 만들어 그 자리에서 세션 쿠키로 바꾼다.
# 세션·RLS·데이터는 전부 진짜다. 우회하는 것은 메일함뿐이다.
# Vercel 에는 어느 환경에도 넣지 말 것 — 넣어도 열리지 않는다 (.vercelignore 가 파일 자체를 뺀다).
TRAIL_DEV_LOGIN=

# /auth/dev-signin 이 열어 줄 유일한 계정. 비어 있으면 라우트는 항상 404다.
TRAIL_DEV_LOGIN_EMAIL=

# ─────────────────────────────────────────────────────────────
# 6. 설문 (/survey) — 응답 CSV 내려받기
# ─────────────────────────────────────────────────────────────
# 설문 응답 저장 자체는 SUPABASE_SERVICE_ROLE_KEY 만 있으면 동작한다.
# 이 토큰은 응답 CSV를 내려받는 /api/survey/export 에만 쓴다.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# 비워두면 export 라우트는 존재를 알리지 않고 404다(응답 수집은 계속 된다).
SURVEY_EXPORT_TOKEN=

# ─────────────────────────────────────────────────────────────
# 7. 공유 링크 (/s/…) — 읽기 전용 트립 공유
# ─────────────────────────────────────────────────────────────
# TRLS1 공유 링크의 HMAC 서명 키. 32바이트 랜덤이면 된다:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# TRAIL_PASS_SIGNING_KEY 와 **반드시 다른 값**을 쓴다. 공유 링크가 유출돼 이 키를
# 갈아엎어도 드롭오프 패스는 살아 있어야 하고, 그 반대도 마찬가지다.
# DB에는 토큰의 sha256 해시만 들어간다. 발급·철회는 SUPABASE_SERVICE_ROLE_KEY 도 함께
# 요구한다. 둘 중 하나라도 비어 있으면 발급 라우트는 503, /s/… 는 전부 만료 화면이다.
TRAIL_SHARE_SIGNING_KEY=
